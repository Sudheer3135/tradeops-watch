    {
      "id": 4,
      "type": "timeseries",
      "title": "Observed restarts in 10 minutes",
      "description": "Observed changes of process start timestamp; a fresh first sample is not a restart.",
      "gridPos": {
        "x": 16,
        "y": 1,
        "w": 8,
        "h": 5
      },
      "datasource": {
        "type": "prometheus",
        "uid": "prometheus"
      },
      "targets": [
        {
          "refId": "A",
          "expr": "changes(process_start_time_seconds{job=\"tradeops\"}[10m])",
          "legendFormat": "{{service}}",
          "datasource": {
            "type": "prometheus",
            "uid": "prometheus"
          },
          "range": true,
          "instant": false
