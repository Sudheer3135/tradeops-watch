[Unit]
Description=TradeOps synthetic market feed
After=network.target

[Service]
User=tradeops
Group=tradeops
ExecStart=/opt/tradeops/venv/bin/python /opt/tradeops/services/market_feed.py
Restart=on-failure
RestartSec=5
NoNewPrivileges=true
ProtectSystem=strict
ProtectHome=true
ReadWritePaths=/var/log/tradeops

[Install]
WantedBy=multi-user.target
